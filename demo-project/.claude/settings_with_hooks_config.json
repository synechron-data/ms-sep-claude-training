{
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(npm run *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Read(**)",
      "Write(backend/src/**)",
      "Write(frontend/src/**)",
      "Write(.claude/agent-memory/**)",
      "Edit(.claude/agent-memory/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install *)",
      "Write(backend/pom.xml)",
      "Write(frontend/package.json)"
    ],
    "deny": [
      "Read(**/application.properties)",
      "Read(**/*.key)",
      "Bash(rm -rf:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pretooluse-demo.js"
          },
          {
            "type": "http",
            "url": "https://example.com/validate"
          },
          {
            "type": "prompt",
            "prompt": "Evaluate the steps before running the tool"
          },
          {
            "type": "agent",
            "prompt": "Run the security-analyst to verify the issues"
          },
          {
            "type": "mcp_tool",
            "server": "some-mcp-server",
            "tool": "some-mcp-tool"
          }
        ]
      }
    ]
  }
}